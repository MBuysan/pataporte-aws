# Copiar a .env y completar. Nunca commitear el .env.
# Las variables de AWS para desarrollo local (LocalStack) ya vienen en docker-compose.yml.

# Base de datos (el contenedor db usa estos mismos valores)
DB_USER=pataporte
DB_PASSWORD=change-me
DB_NAME=pataporte
DB_PORT=5432

# JWT
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Correo (contraseña de aplicación de Gmail)
MAIL_USERNAME=pataporteuy@gmail.com
MAIL_PASSWORD=change-me
MAIL_FROM=pataporteuy@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

ENVIRONMENT=development
LOG_LEVEL=INFO
