# Solo desarrollo local. Generar claves con python3 scripts/init_local.py
DB_USER=pataporte
DB_PASSWORD=generar-con-init-local
DB_NAME=pataporte
DATABASE_URL=postgresql://pataporte:generar-con-init-local@db:5432/pataporte
SECRET_KEY=generar-con-init-local
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
# En AWS: DATABASE_SSLMODE=verify-full y DATABASE_SSLROOTCERT=/app/certs/us-east-1-bundle.pem
DATABASE_SSLMODE=prefer

# Buzón local: no envía correo a Internet.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SSL=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=pataporte@example.com
MAIL_TIMEOUT=10
MAIL_DELIVERY_ENABLED=true

# Local por defecto; en ECS se inyectan bucket/cola y un rol de tarea autorizado.
AWS_REGION=us-east-1
STORAGE_BACKEND=local
ASSETS_BUCKET=
PHOTO_MAX_BYTES=5242880
MESSAGE_TRANSPORT=rabbitmq
SQS_QUEUE_URL=
IDEMPOTENCY_TABLE=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=pataporte
RABBITMQ_PASSWORD=generar-con-init-local
FRONTEND_PORT=8085
API_PORT=8000
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672
