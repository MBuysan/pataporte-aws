FROM public.ecr.aws/lambda/python:3.12
COPY requirements-lambda.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt
COPY config/mail.py ${LAMBDA_TASK_ROOT}/config/mail.py
COPY utils/email.py ${LAMBDA_TASK_ROOT}/utils/email.py
COPY messaging/delivery.py messaging/lambda_handler.py ${LAMBDA_TASK_ROOT}/messaging/
CMD ["messaging.lambda_handler.handler"]
